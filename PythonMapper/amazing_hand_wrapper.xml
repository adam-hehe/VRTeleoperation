<mujoco model="amazing_hand_wrapper">
  <option gravity="0 0 -9.81" timestep="0.002" integrator="RK4"/>

  <!-- Contact & dynamics defaults for stability and crisp contacts -->
  <default>
    <!-- 3D frictional contacts; stiffer contact with light damping -->
    <geom  condim="3" solref="0.002 1" solimp="0.9 0.95 0.001" friction="1 0.1 0.001"/>
    <!-- Mild joint damping and armature help with stability under contact loads -->
    <joint damping="0.1" armature="0.002"/>
  </default>

  <include file="scene.xml"/>

  <worldbody>
    <!-- Your cube -->
    <body name="test_cube" pos="0.055 0.03 0.10">
      <joint type="free" name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.012 0.02 0.012"
            rgba="0.4 0.6 0.8 1" contype="1" conaffinity="1" mass="0.10"
            friction="2 0.2 0.01"/>
    </body>
  </worldbody>
</mujoco>
